# Template for the local .env file. Copy to `.env` and fill in real values.
#   cp .env.example .env
# The real .env is git-ignored and must never be committed.

# --- PostgreSQL (used by database_connection.py and chatbot/agent.py) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=supply_chain_db
PGUSER=postgres
PGPASSWORD=your_password

# --- PostgreSQL (DB_* names used by backend/db_connection.py) - keep in sync ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supply_chain_db
DB_USER=postgres
DB_PASSWORD=your_password

# --- OpenAI (chatbot) ---
# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=<paste-your-openai-key-here>
OPENAI_MODEL=gpt-4o-mini
